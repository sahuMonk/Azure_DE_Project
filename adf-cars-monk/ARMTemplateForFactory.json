						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "select * from source_car_data where date_Id> '@{activity('last load').output.value[0].last_load}' and date_Id<= '@{activity('current load').output.value[0].max_date}'",
