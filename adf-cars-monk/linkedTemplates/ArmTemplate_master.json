{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-cars-monk"
		},
		"AzureDatabricks1_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'AzureDatabricks1'"
		},
		"linkedservicesSqlDB_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'linkedservicesSqlDB'"
		},
		"ls_datalake_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_datalake'"
		},
		"AzureDatabricks1_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "0721-121210-9vua7d7m"
		},
		"linkedservicesSqlDB_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "carsaleservermonk.database.windows.net"
		},
		"linkedservicesSqlDB_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "carsales"
		},
		"linkedservicesSqlDB_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adminmonk"
		},
		"linkedservices_git_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com"
		},
		"ls_datalake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://carsdatalakemonk.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-cars-monk_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDatabricks1_accessToken": {
						"value": "[parameters('AzureDatabricks1_accessToken')]"
					},
					"linkedservicesSqlDB_password": {
						"value": "[parameters('linkedservicesSqlDB_password')]"
					},
					"ls_datalake_accountKey": {
						"value": "[parameters('ls_datalake_accountKey')]"
					},
					"AzureDatabricks1_properties_typeProperties_existingClusterId": {
						"value": "[parameters('AzureDatabricks1_properties_typeProperties_existingClusterId')]"
					},
					"linkedservicesSqlDB_properties_typeProperties_server": {
						"value": "[parameters('linkedservicesSqlDB_properties_typeProperties_server')]"
					},
					"linkedservicesSqlDB_properties_typeProperties_database": {
						"value": "[parameters('linkedservicesSqlDB_properties_typeProperties_database')]"
					},
					"linkedservicesSqlDB_properties_typeProperties_userName": {
						"value": "[parameters('linkedservicesSqlDB_properties_typeProperties_userName')]"
					},
					"linkedservices_git_properties_typeProperties_url": {
						"value": "[parameters('linkedservices_git_properties_typeProperties_url')]"
					},
					"ls_datalake_properties_typeProperties_url": {
						"value": "[parameters('ls_datalake_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}